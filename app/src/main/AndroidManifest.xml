<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 11+: necessário para o celular achar o Spotify instalado -->
    <queries>
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:theme="@style/AppTheme"
        android:label="TelaTV"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Executa a ação do atalho/Tile sem mostrar tela -->
        <activity
            android:name=".ToggleActivity"
            android:exported="false"
            android:theme="@style/TransparentTheme"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <service
            android:name=".ToggleTileService"
            android:exported="true"
            android:label="Tela da TV"
            android:icon="@drawable/ic_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
